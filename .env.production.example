# Set these in your hosting provider's encrypted environment-variable settings.
# Never commit a real .env file.
DATABASE_URL="postgresql://...pooled..."
DIRECT_URL="postgresql://...direct..."
APP_URL="https://mountkenyaawards.co.ke"
ADMIN_EMAIL="your-private-admin-email@example.com"
ADMIN_INITIAL_PASSWORD="set-a-unique-password-of-16-or-more-characters"
ADMIN_SESSION_SECRET="set-a-cryptographically-random-secret-of-32-or-more-characters"

# Payments deliberately remain disabled until Safaricom Business + Daraja onboarding is complete.
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="https://mountkenyaawards.co.ke/api/payments/mpesa/callback"
DARAJA_TRANSACTION_TYPE="CustomerPayBillOnline"
